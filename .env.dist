# Native/developer MongoDB connection URI. MongoDB is an external requirement.
# Docker Compose builds its internal URI from DATABASE_USER and DATABASE_PASSWORD.
DATABASE_URL=mongodb://localhost:27017/
DATABASE_DB=mangayomi
HOST=0.0.0.0
PORT=8080
SESSION_TTL_DAYS=30
# Generate a unique 64-byte value for production; native setup can generate one
# when no existing configuration value is supplied.
SECRET_KEY=
ALLOW_REGISTRATION=false

# Docker Compose compatibility values. Set both to values you choose before
# using docker-compose.yml or docker-compose-arm64.yml; native releases ignore them.
# Compose defaults DATABASE_DB, SESSION_TTL_DAYS, and ALLOW_REGISTRATION when
# older host .env files omit those keys. It never supplies a secret or credential.
DATABASE_USER=
DATABASE_PASSWORD=
